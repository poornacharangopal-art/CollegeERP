<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Faculty Details</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #eef2ff, #dbeafe);
            min-height: 100vh;
            padding: 40px;
        }

        .heading {
            text-align: center;
            margin-bottom: 35px;
            color: #1e293b;
            font-size: 32px;
        }

        .faculty-container {
            max-width: 1100px;
            margin: auto;

            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(300px, 1fr));

            gap: 25px;
        }

        .faculty-card {
            background: white;

            padding: 25px;

            border-radius: 15px;

            box-shadow:
                0 8px 25px rgba(0, 0, 0, 0.12);

            transition: 0.3s;
        }

        .faculty-card:hover {
            transform: translateY(-5px);

            box-shadow:
                0 12px 30px rgba(0, 0, 0, 0.18);
        }

        .faculty-name {
            color: #2563eb;

            font-size: 24px;

            margin-bottom: 18px;
        }

        .faculty-detail {
            margin: 10px 0;

            color: #475569;

            font-size: 16px;
        }

        .faculty-detail span {
            font-weight: bold;

            color: #1e293b;
        }

        .courses {
            margin-top: 18px;
        }

        .courses h4 {
            color: #1e293b;

            margin-bottom: 8px;
        }

        .courses ul {
            padding-left: 20px;
        }

        .courses li {
            margin: 5px 0;

            color: #475569;
        }

        .update-btn {
            display: inline-block;

            margin-top: 20px;

            padding: 10px 20px;

            background: #2563eb;

            color: white;

            text-decoration: none;

            border-radius: 8px;

            transition: 0.3s;
        }

        .update-btn:hover {
            background: #1d4ed8;
        }

        .no-faculty {
            text-align: center;

            font-size: 20px;

            color: #64748b;
        }

    </style>

</head>

<body>

    <h1 class="heading">
        Faculty Details
    </h1>


    <div class="faculty-container">

        <% if (faculty.length === 0) { %>

            <p class="no-faculty">
                No Faculty Found
            </p>

        <% } %>


        <% faculty.forEach((fac) => { %>

            <div class="faculty-card">

                <h2 class="faculty-name">
                    <%= fac.name %>
                </h2>


                <p class="faculty-detail">
                    <span>Email:</span>
                    <%= fac.email %>
                </p>


                <p class="faculty-detail">
                    <span>Employee ID:</span>
                    <%= fac.EmployeeId %>
                </p>


                <p class="faculty-detail">
                    <span>Department:</span>
                    <%= fac.deparment %>
                </p>


                <p class="faculty-detail">
                    <span>Designation:</span>
                    <%= fac.designation %>
                </p>


                <div class="courses">

                    <h4>
                        Courses:
                    </h4>

                    <% if (fac.courses && fac.courses.length > 0) { %>

                        <ul>

                            <% fac.courses.forEach((course) => { %>

                                <li>
                                    <%= course %>
                                </li>

                            <% }) %>

                        </ul>

                    <% } else { %>

                        <p>
                            No courses assigned
                        </p>

                    <% } %>

                </div>


                <a
                    href="/dispalayfacultyupdate/<%= fac._id %>"
                    class="update-btn"
                >
                    Update
                </a>

            </div>

        <% }) %>

    </div>

</body>

</html>