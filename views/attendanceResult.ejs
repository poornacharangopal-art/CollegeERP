<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Result</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            min-height: 100vh;
            background: #f5f1e8;
            padding: 40px;
        }

        .container {
            max-width: 800px;
            margin: auto;
        }

        .header {
            background: #155d3a;
            color: white;
            padding: 25px;
            border-radius: 12px 12px 0 0;
        }

        .header h1 {
            margin-bottom: 8px;
        }

        .header p {
            color: #f2c94c;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
        }

        .details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .detail {
            padding: 18px;
            background: #f8f6ef;
            border-left: 5px solid #d4af37;
            border-radius: 8px;
        }

        .detail h3 {
            color: #155d3a;
            margin-bottom: 8px;
        }

        .detail p {
            font-size: 18px;
            color: #333;
        }

        .back {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 22px;
            background: #155d3a;
            color: white;
            text-decoration: none;
            border-radius: 7px;
        }

        .back:hover {
            background: #0e472c;
        }

        @media (max-width: 600px) {
            body {
                padding: 20px;
            }

            .details {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <h1>Attendance Details</h1>
            <p>Student Attendance Record</p>
        </div>

        <div class="card">

            <div class="details">

                <div class="detail">
                    <h3>Roll Number</h3>
                    <p><%= attendance.rollNumber %></p>
                </div>

                <div class="detail">
                    <h3>Semester</h3>
                    <p><%= attendance.semester %></p>
                </div>

                <div class="detail">
                    <h3>Month</h3>
                    <p><%= attendance.month %></p>
                </div>

                <div class="detail">
                    <h3>Working Days</h3>
                    <p><%= attendance.workingDays %></p>
                </div>

                <div class="detail">
                    <h3>Holidays</h3>
                    <p><%= attendance.Holidays %></p>
                </div>

                <div class="detail">
                    <h3>Present Days</h3>
                    <p><%= attendance.PresentDays %></p>
                </div>

            </div>

            <a href="/studentattendance" class="back">
                ← Back to Attendance
            </a>

        </div>

    </div>

</body>
</html>