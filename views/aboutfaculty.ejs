<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Faculty</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            font-family: Arial, sans-serif;

            background: linear-gradient(
                135deg,
                #dbeafe,
                #eef2ff
            );
        }

        .container {

            width: 400px;

            padding: 35px;

            background: white;

            border-radius: 15px;

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.15);

            text-align: center;
        }

        .container h1 {

            margin-bottom: 10px;

            color: #1e293b;
        }

        .container p {

            margin-bottom: 25px;

            color: #64748b;
        }

        .form-group {

            text-align: left;

            margin-bottom: 20px;
        }

        .form-group label {

            display: block;

            margin-bottom: 8px;

            font-weight: bold;

            color: #334155;
        }

        .form-group select {

            width: 100%;

            padding: 12px;

            border: 1px solid #cbd5e1;

            border-radius: 8px;

            font-size: 16px;

            outline: none;
        }

        .form-group select:focus {

            border-color: #2563eb;
        }

        .submit-btn {

            width: 100%;

            padding: 12px;

            border: none;

            border-radius: 8px;

            background: #2563eb;

            color: white;

            font-size: 16px;

            cursor: pointer;

            transition: 0.3s;
        }

        .submit-btn:hover {

            background: #1d4ed8;

        }

    </style>

</head>

<body>

    <div class="container">

        <h1>
            Faculty Details
        </h1>

        <p>
            Select a department to view faculty
        </p>


        <form
            action="/facultydetails"
            method="POST"
        >

            <div class="form-group">

                <label for="department">
                    Department
                </label>

                <select
                    name="department"
                    id="department"
                    required
                >

                    <option value="">
                        Select Department
                    </option>

                    <option value="CSE">
                        Computer Science and Engineering
                    </option>

                    <option value="ECE">
                        Electronics and Communication Engineering
                    </option>

                    <option value="EE">
                        Electrical Engineering
                    </option>

                    <option value="ME">
                        Mechanical Engineering
                    </option>

                    <option value="CE">
                        Civil Engineering
                    </option>

                </select>

            </div>


            <button
                type="submit"
                class="submit-btn"
            >
                View Faculty
            </button>

        </form>

    </div>

</body>

</html>