<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Dashboard | NIT Patna</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f5f2e9;
            color: #26332f;
        }

        /* ================= NAVBAR ================= */

        .navbar {
            height: 72px;

            background: #203c33;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 6%;

            color: white;

            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;

            font-size: 21px;
            font-weight: 700;
        }

        .logo-box {
            width: 43px;
            height: 43px;

            background: #d4b15d;

            color: #203c33;

            border-radius: 11px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-weight: 800;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .student-name {
            color: #e9ece9;
            font-size: 14px;
        }

        .logout {
            text-decoration: none;

            padding: 9px 18px;

            border: 1px solid #d4b15d;

            color: #f0d88e;

            border-radius: 8px;

            font-size: 14px;

            transition: 0.25s;
        }

        .logout:hover {
            background: #d4b15d;
            color: #203c33;
        }

        /* ================= HERO ================= */

        .hero {
            padding: 55px 7% 45px;

            background-image: url("https://i.postimg.cc/xdyTrpJ7/Desktop-4-jpg-(1).jpg");

            background-size: cover;
            background-position: center;

            position: relative;

            color: white;
        }

        .hero::before {
            content: "";

            position: absolute;

            inset: 0;

            background: rgba(27, 48, 41, 0.70);
        }

        .hero-content {
            position: relative;
            z-index: 1;

            max-width: 900px;
        }

        .hero h1 {
            font-size: 38px;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 16px;

            color: #e3e8e4;

            line-height: 1.7;
        }

        /* ================= MAIN ================= */

        .main {
            width: 86%;

            max-width: 1200px;

            margin: 45px auto 70px;
        }

        .section-heading {
            margin-bottom: 25px;
        }

        .section-heading h2 {
            color: #203c33;

            font-size: 28px;

            margin-bottom: 6px;
        }

        .section-heading p {
            color: #747d78;

            font-size: 14px;
        }

        /* ================= CARDS ================= */

        .cards {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 22px;
        }

        .card {
            background: white;

            border: 1px solid #ded9cc;

            border-radius: 16px;

            padding: 30px 25px;

            min-height: 215px;

            box-shadow:
                0 10px 25px rgba(32, 60, 51, 0.07);

            transition: 0.3s;

            display: flex;

            flex-direction: column;

            justify-content: space-between;
        }

        .card:hover {
            transform: translateY(-6px);

            box-shadow:
                0 18px 35px rgba(32, 60, 51, 0.13);

            border-color: #cfb66e;
        }

        .icon {
            width: 55px;
            height: 55px;

            background: #eee7d5;

            color: #285c4d;

            border-radius: 14px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 25px;

            margin-bottom: 18px;
        }

        .card h3 {
            color: #203c33;

            font-size: 20px;

            margin-bottom: 8px;
        }

        .card p {
            color: #737c77;

            font-size: 14px;

            line-height: 1.6;

            margin-bottom: 20px;
        }

        .card-btn {
            text-decoration: none;

            display: inline-block;

            width: fit-content;

            padding: 10px 18px;

            background: #285c4d;

            color: white;

            border-radius: 8px;

            font-size: 14px;

            font-weight: 600;

            transition: 0.25s;
        }

        .card-btn:hover {
            background: #1d493d;

            transform: translateX(3px);
        }

        /* ================= STUDENT INFORMATION ================= */

        .student-info {
            margin-top: 45px;

            background: white;

            border: 1px solid #ded9cc;

            border-radius: 16px;

            padding: 30px;

            box-shadow:
                0 10px 25px rgba(32, 60, 51, 0.06);
        }

        .student-info h2 {
            color: #203c33;

            font-size: 23px;

            margin-bottom: 22px;
        }

        .info-grid {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 18px;
        }

        .info-item {
            padding: 17px;

            background: #f5f2e9;

            border-radius: 10px;

            border-left: 4px solid #c9a452;
        }

        .info-label {
            display: block;

            color: #7b847f;

            font-size: 12px;

            margin-bottom: 5px;
        }

        .info-value {
            color: #203c33;

            font-size: 15px;

            font-weight: 600;
        }

        /* ================= FOOTER ================= */

        footer {
            background: #203c33;

            color: #cbd3ce;

            text-align: center;

            padding: 25px;

            font-size: 13px;
        }

        footer strong {
            color: #d9b96a;
        }

        /* ================= RESPONSIVE ================= */

        @media(max-width: 900px) {

            .cards {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .info-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

        }

        @media(max-width: 600px) {

            .navbar {
                padding: 0 20px;
            }

            .student-name {
                display: none;
            }

            .hero {
                padding: 45px 25px;
            }

            .hero h1 {
                font-size: 29px;
            }

            .main {
                width: 90%;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


<body>


    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <div class="logo">

            <div class="logo-box">
                NIT
            </div>

            <span>
                NIT Patna
            </span>

        </div>


        <div class="nav-right">

            <span class="student-name">
                Welcome, <%= student.name %>
            </span>

            <a
                href="/student/logout"
                class="logout"
            >
                Logout
            </a>

        </div>

    </nav>


    <!-- ================= HERO ================= -->

    <section class="hero">

        <div class="hero-content">

            <h1>
                Welcome, <%= student.name %> 👋
            </h1>

            <p>
                Access your academic information,
                attendance, marks and student profile
                from one place.
            </p>

        </div>

    </section>


    <!-- ================= MAIN ================= -->

    <main class="main">


        <div class="section-heading">

            <h2>
                Student Portal
            </h2>

            <p>
                Select an option to access your academic information.
            </p>

        </div>


        <!-- ================= DASHBOARD CARDS ================= -->

        <div class="cards">


            <!-- MARKS -->

            <div class="card">

                <div>

                    <div class="icon">
                        📊
                    </div>

                    <h3>
                        Marks
                    </h3>

                    <p>
                        View your semester-wise marks
                        and academic performance.
                    </p>

                </div>

                <a
                    href="/studentmarks"
                    class="card-btn"
                >
                    View Marks →
                </a>

            </div>


            <!-- ATTENDANCE -->

            <div class="card">

                <div>

                    <div class="icon">
                        📅
                    </div>

                    <h3>
                        Attendance
                    </h3>

                    <p>
                        Check your monthly attendance
                        and attendance records.
                    </p>

                </div>

                <a
                    href="/studentattendance"
                    class="card-btn"
                >
                    View Attendance →
                </a>

            </div>


            <!-- PROFILE -->

            <div class="card">

                <div>

                    <div class="icon">
                        👤
                    </div>

                    <h3>
                        My Profile
                    </h3>

                    <p>
                        View your personal and academic
                        student information.
                    </p>

                </div>

                <a
                    href="/student/profile"
                    class="card-btn"
                >
                    View Profile →
                </a>

            </div>


        </div>


        <!-- ================= STUDENT INFORMATION ================= -->

        <section class="student-info">

            <h2>
                Student Information
            </h2>


            <div class="info-grid">


                <div class="info-item">

                    <span class="info-label">
                        Name
                    </span>

                    <span class="info-value">
                        <%= student.name %>
                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Email
                    </span>

                    <span class="info-value">
                        <%= student.email %>
                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Roll Number
                    </span>

                    <span class="info-value">
                        <%= student.rollNumber %>
                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Department
                    </span>

                    <span class="info-value">
                        <%= student.department %>
                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Admission Year
                    </span>

                    <span class="info-value">
                        <%= student.Admissionyear %>
                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Semester
                    </span>

                    <span class="info-value">
                        <%= student.semester %>
                    </span>

                </div>


            </div>

        </section>


    </main>


    <!-- ================= FOOTER ================= -->

    <footer>

        © 2026 <strong>NIT Patna</strong> —
        Student Academic Management System

    </footer>


</body>

</html>