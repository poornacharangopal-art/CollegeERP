<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Added Successfully</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background-color: #eef3ed;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .success-box {
            width: 450px;
            background-color: white;
            padding: 45px 35px;
            border-radius: 18px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
            border-top: 6px solid #176b3a;
        }

        .icon {
            width: 75px;
            height: 75px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background-color: #176b3a;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 42px;
            font-weight: bold;
        }

        h1 {
            color: #176b3a;
            margin-bottom: 12px;
            font-size: 28px;
        }

        p {
            color: #555;
            font-size: 16px;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
        }

        a {
            text-decoration: none;
            padding: 12px 22px;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
        }

        .dashboard {
            background-color: #176b3a;
            color: white;
        }

        .dashboard:hover {
            background-color: #0f512b;
        }

        .add-another {
            background-color: #d4a017;
            color: white;
        }

        .add-another:hover {
            background-color: #b8860b;
        }

        .logo {
            margin-top: 28px;
            width: 55px;
            height: 55px;
            object-fit: contain;
        }

        @media (max-width: 500px) {
            .success-box {
                width: 90%;
                padding: 35px 20px;
            }

            .buttons {
                flex-direction: column;
            }

            a {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <div class="success-box">

        <div class="icon">
            ✓
        </div>

        <h1>Student Added Successfully!</h1>

        <p>
            The student has been successfully added to the NIT Patna
            College ERP system.
        </p>

        <div class="buttons">
            <a href="/displayAddstudent" class="add-another">
                Add Another Student
            </a>

            <a href="/admindashboard" class="dashboard">
                Go to Dashboard
            </a>
        </div>

        <img
            class="logo"
            src="https://www.nitp.ac.in/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Flogo.0wkg4jthc83lp.png&w=256&q=75"
            alt="NIT Patna Logo"
        >

    </div>

</body>
</html>