<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>My Marks</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            font-family: Arial, sans-serif;

            min-height: 100vh;

            background: linear-gradient(
                135deg,
                #dbeafe,
                #eef2ff
            );

            padding: 40px 20px;
        }

        .container {

            max-width: 800px;

            margin: auto;
        }

        .student-card {

            background: white;

            padding: 30px;

            border-radius: 15px;

            box-shadow:
                0 8px 25px rgba(0, 0, 0, 0.12);

            margin-bottom: 25px;
        }

        .student-card h1 {

            text-align: center;

            color: #2563eb;

            margin-bottom: 25px;
        }

        .details {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 15px;
        }

        .detail {

            background: #eff6ff;

            padding: 15px;

            border-radius: 8px;

            text-align: center;
        }

        .detail p {

            color: #64748b;

            font-size: 14px;

            margin-bottom: 5px;
        }

        .detail strong {

            color: #1e293b;

            font-size: 17px;
        }

        .marks-card {

            background: white;

            padding: 30px;

            border-radius: 15px;

            box-shadow:
                0 8px 25px rgba(0, 0, 0, 0.12);
        }

        .marks-card h2 {

            text-align: center;

            color: #1e293b;

            margin-bottom: 20px;
        }

        table {

            width: 100%;

            border-collapse: collapse;
        }

        th {

            background: #2563eb;

            color: white;

            padding: 14px;
        }

        td {

            padding: 14px;

            text-align: center;

            border-bottom: 1px solid #ddd;

            color: #334155;
        }

        .marks {

            font-weight: bold;

            color: #2563eb;
        }

        @media(max-width:600px) {

            .details {

                grid-template-columns: 1fr;

            }

        }

    </style>

</head>


<body>


    <div class="container">


        <!-- Student Details -->

        <div class="student-card">

            <h1>
                Student Marks
            </h1>


            <div class="details">


                <div class="detail">

                    <p>
                        Name
                    </p>

                    <strong>
                        <%= student.name %>
                    </strong>

                </div>


                <div class="detail">

                    <p>
                        Roll Number
                    </p>

                    <strong>
                        <%= marks.RollNumber %>
                    </strong>

                </div>


                <div class="detail">

                    <p>
                        Semester
                    </p>

                    <strong>
                        <%= marks.semester %>
                    </strong>

                </div>


            </div>

        </div>



        <!-- Subject Marks -->

        <div class="marks-card">

            <h2>
                Subject Marks
            </h2>


            <table>

                <thead>

                    <tr>

                        <th>
                            Subject
                        </th>

                        <th>
                            Marks
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% marks.Marks.forEach((item) => { %>

                        <tr>

                            <td>
                                <%= item.subject %>
                            </td>

                            <td class="marks">
                                <%= item.marks %>
                            </td>

                        </tr>

                    <% }) %>


                </tbody>

            </table>

        </div>


    </div>


</body>

</html>