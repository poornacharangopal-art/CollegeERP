<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Login | NIT Patna</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        html,
        body {
            width: 100%;
            height: 100%;
        }

        body {

            /* Image background */
            background-image: url("https://i.postimg.cc/xdyTrpJ7/Desktop-4-jpg-(1).jpg");

            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;
        }

        /* Dark transparent layer over image */

        body::before {

            content: "";

            position: absolute;

            inset: 0;

            background: rgba(20, 35, 30, 0.48);
        }


        /* ================= LOGIN CARD ================= */

        .login-card {

            width: 420px;

            padding: 42px;

            background: rgba(255, 255, 255, 0.94);

            border: 1px solid rgba(255, 255, 255, 0.7);

            border-radius: 20px;

            box-shadow:
                0 25px 60px rgba(0, 0, 0, 0.28);

            position: relative;

            z-index: 2;
        }


        /* ================= LOGO ================= */

        .logo {

            width: 70px;
            height: 70px;

            margin: 0 auto 20px;

            border-radius: 18px;

            background: #285c4d;

            color: white;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 25px;

            font-weight: 800;

            box-shadow:
                0 8px 20px rgba(40, 92, 77, 0.25);
        }


        /* ================= TITLE ================= */

        h1 {

            text-align: center;

            color: #203c33;

            font-size: 29px;

            margin-bottom: 8px;
        }


        .subtitle {

            text-align: center;

            color: #68736f;

            font-size: 14px;

            line-height: 1.6;

            margin-bottom: 30px;
        }


        /* ================= FORM ================= */

        .form-group {

            margin-bottom: 20px;
        }


        label {

            display: block;

            margin-bottom: 8px;

            color: #30463e;

            font-size: 14px;

            font-weight: 600;
        }


        input {

            width: 100%;

            padding: 14px 15px;

            border: 1px solid #d7d9d4;

            border-radius: 10px;

            outline: none;

            background: rgba(255, 255, 255, 0.9);

            color: #26332f;

            font-size: 15px;

            transition: 0.25s;
        }


        input:focus {

            border-color: #285c4d;

            box-shadow:
                0 0 0 3px rgba(40, 92, 77, 0.10);
        }


        input::placeholder {

            color: #9aa39f;
        }


        /* ================= BUTTON ================= */

        .login-btn {

            width: 100%;

            border: none;

            padding: 14px;

            margin-top: 5px;

            border-radius: 10px;

            background: #285c4d;

            color: white;

            font-size: 16px;

            font-weight: 600;

            cursor: pointer;

            transition: 0.3s;
        }


        .login-btn:hover {

            background: #1e493d;

            transform: translateY(-2px);

            box-shadow:
                0 10px 22px rgba(40, 92, 77, 0.25);
        }


        /* ================= BACK ================= */

        .back {

            display: block;

            text-align: center;

            margin-top: 23px;

            color: #68736f;

            text-decoration: none;

            font-size: 14px;

            transition: 0.25s;
        }


        .back:hover {

            color: #285c4d;
        }


        /* ================= FOOTER ================= */

        .footer {

            text-align: center;

            margin-top: 25px;

            color: #929b96;

            font-size: 11px;
        }


        /* ================= MOBILE ================= */

        @media(max-width: 500px) {

            .login-card {

                width: 90%;

                padding: 32px 25px;
            }

            h1 {

                font-size: 25px;
            }

        }

    </style>

</head>


<body>


    <div class="login-card">


        <div class="logo">
            NIT
        </div>


        <h1>
            Student Login
        </h1>


        <p class="subtitle">
            Login to access your NIT Patna
            student portal
        </p>


        <form action="/studentslogin" method="POST">


            <div class="form-group">

                <label for="email">
                    Email Address
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                >

            </div>


            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    required
                >

            </div>


            <button
                type="submit"
                class="login-btn"
            >
                Login to Student Portal →
            </button>


        </form>


        <a href="/" class="back">
            ← Back to NIT Patna Home
        </a>


        <div class="footer">
            NIT Patna Academic Management System
        </div>


    </div>


</body>

</html>